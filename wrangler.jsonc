{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neptune-media-webtv",
  "main": "neptune-tv-media-cloudflare/src/entry-v11.js",
  "compatibility_date": "2026-07-16",
  "workers_dev": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "tv.neptunebusiness.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "assets": {
    "directory": "./neptune-tv-media-cloudflare/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/studio/*",
      "/espace-client/*",
      "/confirmation-studio/*",
      "/api/*",
      "/media/*",
      "/direct/*",
      "/emissions/*",
      "/programmes/*",
      "/mentions-legales/*",
      "/confidentialite/*",
      "/contact/*",
      "/robots.txt",
      "/sitemap.xml",
      "/video-sitemap.xml",
      "/llms.txt"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "STUDIO", "class_name": "StudioStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StudioStore"] }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "neptune-media-assets" }
  ],
  "analytics_engine_datasets": [
    { "binding": "MEDIA_ANALYTICS", "dataset": "neptune_media_events" }
  ],
  "ai": { "binding": "AI" },
  "vars": {
    "BOOKING_URL": "https://media.neptunebusiness.com",
    "PREPARATION_BOOKING_URL": "https://calendar.app.google/nkYDeheuV8qjSMcRA",
    "PUBLIC_ORIGIN": "https://tv.neptunebusiness.com",
    "AI_MODEL": "@cf/openai/gpt-oss-120b",
    "AUTH_FROM_EMAIL": "Neptune Media <contact@neptunebusiness.com>",
    "STUDIO_SUPPLIER_NAME": "REC BOX Studio",
    "STUDIO_SUPPLIER_EMAIL": "contact@recbox.fr",
    "STUDIO_ADDRESS": "11 Allée de Longueterre, 31850 Montrabé"
  },
  "observability": { "enabled": true }
}
