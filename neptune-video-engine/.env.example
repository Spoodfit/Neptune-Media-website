# Jeton local partagé avec Neptune Studio. L’installateur en génère un automatiquement.
NEPTUNE_ENGINE_TOKEN=change-me

# Modèle Whisper local. small = bon compromis CPU/qualité.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
NEPTUNE_ENGINE_WORKERS=1

# OpenAI est prioritaire pour la sélection éditoriale. Facultatif si Ollama est utilisé.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Secours local. Laisser vide pour utiliser uniquement les règles Neptune si Ollama n’est pas installé.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

NEPTUNE_ALLOWED_ORIGINS=https://tv.neptunebusiness.com,https://neptune-media-webtv.neptunebusinessclub.workers.dev,http://localhost:8787
